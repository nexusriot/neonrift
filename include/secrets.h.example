// secrets.h — local, git-ignored configuration.
//
// Copy this file to `secrets.h` (same directory) and fill in your values.
// Everything here is OPTIONAL: with no secrets.h at all the firmware boots
// straight into the Wi-Fi setup portal (SoftAP "neonrift-setup").
//
//   cp include/secrets.h.example include/secrets.h
//
#pragma once

// ---- Seed Wi-Fi networks --------------------------------------------------
// Pre-provisioned credentials, merged with anything saved via the web portal.
// Define up to three. Leave undefined to rely solely on portal provisioning.
// #define WIFI_SEED_SSID1 "MyNetwork"
// #define WIFI_SEED_PASS1 "MyPassword"
// #define WIFI_SEED_SSID2 "Backup"
// #define WIFI_SEED_PASS2 "BackupPassword"
// #define WIFI_SEED_SSID3 "Phone-Hotspot"
// #define WIFI_SEED_PASS3 "HotspotPassword"

// ---- API token (optional) -------------------------------------------------
// If set to a non-empty value, mutating endpoints (POST/DELETE /api/wifi,
// POST /api/led, POST /update) require it via either:
//   Authorization: Bearer <token>   header, or   ?token=<token>   query param.
// Leave undefined / empty to keep the API open.
// #define API_TOKEN "change-me"
