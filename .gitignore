# PlatformIO build output
.pio

# VS Code — machine-generated files (extensions.json is kept, it's shared)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# IDE / language-server caches
.cache/
compile_commands.json
.idea/

# Local secrets — Wi-Fi seeds, API token (see include/secrets.h.example)
# Matches secrets.h in any directory; secrets.h.example stays tracked.
secrets.h

# Python bytecode (from build scripts)
__pycache__/
*.pyc

# Editor / OS cruft
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
